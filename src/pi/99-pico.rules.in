# 99-pico.rules -- generated by `remote-serial-pico install` from
# src/pi/99-pico.rules.in; edit the template, not the installed copy.
#
# A Pico running MicroPython enumerates as the USB serial device 2e8a:0005.
# PicoScriptDeployer.py then copies the firmware and a per-board config.json
# onto it. @VENV_PYTHON@ is the rshell venv's interpreter and @CONFIG@ is the
# installed config.yaml; both are filled in at install time, so nothing here
# names a path that is also written down somewhere else.
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0005", RUN+="@VENV_PYTHON@ @APP@/src/pi/PicoScriptDeployer.py --config @CONFIG@ '%E{DEVNAME}' '%E{ID_VENDOR_ID}' '%E{ID_MODEL_ID}' '%E{ID_SERIAL_SHORT}'"
