# Dependencies
node_modules/
jspm_packages/

# npm / yarn debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Runtime logs
*.log
logs/

# Host-specific config and units (generated by `remote-serial-pico i`,
# they contain paths/ports for one machine and must not be shared)
src/pi/config.yaml
src/pi/ptyserver.service

# Python bytecode (a stale .pyc will happily hide a source change)
__pycache__/
*.py[cod]

# Compiled output
*.o
*.out
*.so

# Secrets
.env
.env.*
*.pem
*.key

# Editor / OS cruft
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
