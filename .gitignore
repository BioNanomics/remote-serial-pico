# Dependencies
node_modules/
jspm_packages/

# npm / yarn debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Runtime logs
*.log
logs/

# Host-specific config and units (generated by `remote-serial-pico install`,
# they contain paths/ports for one machine and must not be shared). The
# committed versions are config.example.yaml and config.example.json.
src/pi/config.yaml
src/pi/ptyserver.service
# A per-board config.json holds the WiFi password. The deployer builds it in a
# private temp directory; one must never land in the tree.
src/pico/config.json

# Python bytecode (a stale .pyc will happily hide a source change)
__pycache__/
*.py[cod]

# Compiled output
*.o
*.out
*.so

# Secrets
.env
.env.*
*.pem
*.key

# Editor / OS cruft
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
